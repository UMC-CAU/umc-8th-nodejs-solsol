// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Food {
  id          BigInt           @id @default(autoincrement()) // 기본키, AUTO_INCREMENT
  name        String        @db.VarChar(20)               // VARCHAR(20) 컬럼
  memberFood  MemberFood[]                                // 1:N 관계 (Food -> MemberFood)
  @@map("food")  // 실제 테이블명: "food"
}

model MemberFood {
  id      BigInt @id @default(autoincrement())
  mem_id  BigInt
  food_id BigInt

  member  Member @relation(fields: [mem_id], references: [id])
  food    Food   @relation(fields: [food_id], references: [id])

  @@map("member_food")
}
model Member {
  id               BigInt         @id @default(autoincrement())
  gender           Gender
  birth            DateTime
  address          String?        @db.VarChar(40)
  point            BigInt
  state            Int
  deactivate_date  DateTime?      @map("deactivate_date")
  role             Role
  phone_number     String         @db.VarChar(40)
  email            String @unique @db.VarChar(40)
  password         String         @db.VarChar(40)
  is_phone_verified Boolean
  created_at       DateTime?      @map("created_at")
  updated_at       DateTime?      @map("updated_at")
  name             String         @db.VarChar(40)

  memberFood       MemberFood[]
  memberMissions MemberMission[]
  stores        Store[]       
  reviews       Review[]

  @@map("member")
}

enum Gender {
  MALE
  FEMALE
  UNCHOSEN
}

enum Role {
  USER
  STORE
}

model Mission {
  id         BigInt       @id @default(autoincrement())
  store_id   BigInt
  name       String       @db.VarChar(80)
  deadline   DateTime
  min_cost   Int
  reward     Int
  created_at DateTime     @map("created_at")
  updated_at DateTime     @map("updated_at")

  memberMissions MemberMission[]
  store    Store @relation(fields: [store_id], references: [id])
  @@map("mission")
}

model MemberMission {
  id           BigInt       @id @default(autoincrement())
  member_id    BigInt
  mission_id   BigInt
  state        MissionState
  completed_at DateTime?    @map("completed_at")

  member  Member  @relation(fields: [member_id], references: [id])
  mission Mission @relation(fields: [mission_id], references: [id])

  @@map("member_mission")
}

enum MissionState {
  IN_PROGRESS
  DONE
}

model Region {
  id     BigInt @id @default(autoincrement())
  name   String @db.VarChar(20)

  stores Store[]  // Store.region_id 를 참조하는 반대쪽

  @@map("region")
}

model Store {
  id         BigInt       @id @default(autoincrement())
  region_id  BigInt
  name       String        @db.VarChar(20)
  rate       Int
  category   Category
  owner_id   BigInt
  created_at DateTime      @map("created_at")
  updated_at DateTime      @map("updated_at")

  region     Region        @relation(fields: [region_id], references: [id])
  owner      Member        @relation(fields: [owner_id], references: [id])
  reviews    Review[]
  missions   Mission[]
  
  @@map("store")
}


enum Category {
  CHINESE
  JAPANESE
  FRENCH
  ITALIAN
  AMERICAN
  MEXICAN
  KOREAN
  VIETNAMESE
  ETC
}

model Review {
  id         BigInt      @id @default(autoincrement())
  store_id   BigInt
  mem_id     BigInt
  content    String      @db.VarChar(200)
  rate       Int
  created_at DateTime?   @map("created_at")
  updated_at DateTime?   @map("updated_at")

  store      Store       @relation(fields: [store_id], references: [id])
  member     Member      @relation(fields: [mem_id], references: [id])

  @@map("review")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.VarChar(512)
  expiresAt DateTime @map("expires_at")

  @@map("session")
}